          <!-- 01 -->

          <div class="capability">

            <span class="capability-number">
              01
            </span>

            <div>

              <h3>
                Planning
              </h3>

              <p>
                Help shape how the community tournament series
                runs across its seasons and connects to the
                December All-Star.
              </p>

            </div>

          </div>


          <!-- 02 -->

          <div class="capability">

            <span class="capability-number">
              02
            </span>

            <div>

              <h3>
                Promotion
              </h3>

              <p>
                Keep each season visible within the wider
                CrossFire Legends community through tournament
                communication and community activities.
              </p>

            </div>

          </div>


          <!-- 03 -->

          <div class="capability">

            <span class="capability-number">
              03
            </span>

            <div>

              <h3>
                Participant Communication
              </h3>

              <p>
                Make sure teams understand tournament information,
                requirements, schedules, and updates throughout
                each season.
              </p>

            </div>

          </div>


          <!-- 04 -->

          <div class="capability">

            <span class="capability-number">
              04
            </span>

            <div>

              <h3>
                Tournament Operations
              </h3>

              <p>
                Support the community-facing operation before
                and during tournament play.
              </p>

            </div>

          </div>

        </div>

      </div>


      <div class="services-note">

        <p class="handwritten note note-left">
          season 2 is next.
          <br />
          the road continues →
        </p>

      </div>

    </div>
  </section>


