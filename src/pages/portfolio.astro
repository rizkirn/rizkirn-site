          </span>

        </div>


        <!-- Season 4 -->

        <div class="timeline-step">

          <span class="timeline-label">
            04
          </span>

          <span class="timeline-name">
            Season 4
          </span>

        </div>


        <!-- All-Star -->

        <div class="timeline-step">

          <span class="timeline-label">
            DEC
          </span>

          <span class="timeline-name">
            10-Team All-Star
          </span>

        </div>

      </div>


