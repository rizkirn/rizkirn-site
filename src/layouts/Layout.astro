---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Rizki RN — Community, Content & Esports',
  description = 'Community, content, creator programs, events, and esports by Rizki RN.',
  image = '/og-image.webp',
  noindex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();

/*
 * Astro.site is defined in astro.config.mjs:
 * https://rizkirn.my.id
 */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

/*
 * Structured data
 *
 * Keep this factual and consistent across the whole site.
 * The @id gives search engines one stable identifier for Rizki
 * across Home, Work, and CV.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://rizkirn.my.id/#rizki',
  name: 'Rizki RN',
  url: 'https://rizkirn.my.id/',
  jobTitle: 'Gaming & Esports Community Manager',
  homeLocation: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  description:
    'Community and content professional working across gaming communities, creator programs, events, tournaments, and esports in Indonesia and Southeast Asia.',
  sameAs: [
    'https://www.linkedin.com/in/rizkirn/',
  ],
  knowsAbout: [
    'Community Management',
    'Gaming Communities',
    'Esports',
    'Content',
    'Creator Programs',
    'Community Events',
    'Tournament Operations',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://rizkirn.my.id/#website',
  url: 'https://rizkirn.my.id/',
  name: 'Rizki RN',
  description:
    'Portfolio and professional website of Rizki RN, covering community, content, creator programs, events, and esports.',
  publisher: {
    '@id': 'https://rizkirn.my.id/#rizki',
  },
};
---

<!doctype html>

<html lang="en">

  <head>

    <!-- ========================================================
         CORE
         ======================================================== -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />


    <!-- ========================================================
         OPEN GRAPH
         LinkedIn · WhatsApp · Discord · Facebook · etc.
         ======================================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="Rizki RN"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImageURL}
    />

    <meta
      property="og:image:secure_url"
      content={socialImageURL}
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:alt"
      content="Rizki RN — Community, Content & Esports"
    />

    <meta
      property="og:locale"
      content="en_US"
    />


    <!-- ========================================================
         TWITTER / X
         ======================================================== -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageURL}
    />

    <meta
      name="twitter:image:alt"
      content="Rizki RN — Community, Content & Esports"
    />


    <!-- ========================================================
         STRUCTURED DATA
         ======================================================== -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    ></script>


    <!-- ========================================================
         BROWSER
         ======================================================== -->

    <meta
      name="theme-color"
      content="#f3f0e7"
    />

    <meta
      name="color-scheme"
      content="light"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />


    <!-- ========================================================
         FONTS
         IBM Plex Sans = primary editorial typeface
         Caveat = handwritten annotations only
         ======================================================== -->

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

  </head>


  <body>

    <!-- ======================================================
         SITE HEADER
         ====================================================== -->

    <header class="site-header">

      <div class="site-shell">

        <div class="header-inner">

          <!-- Identity -->

          <a
            href="/"
            class="site-identity"
            aria-label="Rizki RN — Home"
          >

            <span class="site-name">
              RIZKI RN
            </span>

            <span class="site-role">
              community · content · esports
            </span>

          </a>


          <!-- Desktop navigation -->

          <nav
            class="desktop-nav"
            aria-label="Main navigation"
          >

            <a href="/portfolio">
              Work
            </a>

            <a href="/#about">
              About
            </a>

            <a href="/cv">
              CV
            </a>

            <a href="/#contact">
              Contact
            </a>

          </nav>


          <!-- Mobile menu button -->

          <button
            class="menu-toggle"
            type="button"
            aria-label="Open navigation"
            aria-controls="mobile-navigation"
            aria-expanded="false"
          >
            <span></span>
            <span></span>
          </button>

        </div>

      </div>


      <!-- Mobile navigation -->

      <nav
        id="mobile-navigation"
        class="mobile-nav"
        aria-label="Mobile navigation"
        data-open="false"
      >

        <div class="site-shell mobile-nav-inner">

          <a href="/portfolio">
            <span>01</span>
            Work
          </a>

          <a href="/#about">
            <span>02</span>
            About
          </a>

          <a href="/cv">
            <span>03</span>
            CV
          </a>

          <a href="/#contact">
            <span>04</span>
            Contact
          </a>

        </div>

      </nav>

    </header>


    <!-- ======================================================
         PAGE
         ====================================================== -->

    <main>
      <slot />
    </main>


    <!-- ======================================================
         FOOTER
         ====================================================== -->

    <footer class="site-footer">

      <div class="site-shell">

        <div class="footer-rule"></div>


        <div class="footer-main">

          <!-- Identity -->

          <div class="footer-identity">

            <p class="footer-name">
              RIZKI RN
            </p>

            <p class="footer-description">
              Community · Content · Esports
            </p>

          </div>


          <!-- Current work -->

          <div class="footer-status">

            <span class="footer-label">
              CURRENTLY
            </span>

            <span>
              CrossFire Legends
            </span>

          </div>


          <!-- Location -->

          <div class="footer-location">

            <span class="footer-label">
              BASED
            </span>

            <span>
              Indonesia
            </span>

          </div>


          <!-- Contact -->

          <div class="footer-links">

            <a
              href="mailto:mail.rizkirn@gmail.com"
              aria-label="Email Rizki RN"
            >
              Email ↗
            </a>

            <a
              href="https://www.linkedin.com/in/rizkirn/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn ↗
            </a>

          </div>

        </div>


        <!-- Notebook-style footer note -->

        <div class="footer-bottom">

          <p class="footer-copyright">
            © {currentYear} Rizki RN
          </p>

          <p class="handwritten footer-note">
            still building things.
          </p>

        </div>

      </div>

    </footer>


    <!-- ======================================================
         MOBILE NAV SCRIPT
         ====================================================== -->

    <script is:inline>
      (() => {
        const toggle = document.querySelector('.menu-toggle');
        const nav = document.querySelector('.mobile-nav');

        if (!toggle || !nav) return;

        const closeMenu = () => {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open navigation');
          nav.setAttribute('data-open', 'false');
          document.body.classList.remove('menu-open');
        };

        const openMenu = () => {
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close navigation');
          nav.setAttribute('data-open', 'true');
          document.body.classList.add('menu-open');
        };

        toggle.addEventListener('click', () => {
          const isOpen =
            toggle.getAttribute('aria-expanded') === 'true';

          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 760) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMenu();
          }
        });
      })();
    </script>

  </body>

</html>